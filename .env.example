# ==============================================================================
# CONFIGURACIÓN GENERAL DE LA APLICACIÓN
# ==============================================================================
# Nombre de tu aplicación (se usa en correos y vistas)
APP_NAME=Laravel
# Entorno actual ('local' para desarrollo, 'production' para el servidor real)
APP_ENV=local
# Clave única de encriptación de la app (¡NO la compartas ni la cambies a la ligera!)
APP_KEY=base64:/dm1Njdxyzw2GkirVkoTL1kbXqA0GzZ0umVukEdc6Do=
# Muestra errores detallados en pantalla si algo falla (poner en 'false' en producción)
APP_DEBUG=true
# URL base de tu aplicación
APP_URL=http://localhost

# ==============================================================================
# CONFIGURACIÓN DE LOGS (REGISTRO DE ERRORES)
# ==============================================================================
# Canal donde se guardan los errores (por defecto escribe en storage/logs/laravel.log)
LOG_CHANNEL=stack
# Canal exclusivo para registrar advertencias de funciones obsoletas (desactivado)
LOG_DEPRECATIONS_CHANNEL=null
# Nivel mínimo de errores que se registrarán (debug registrará todo: advertencias, info, errores)
LOG_LEVEL=debug

# ==============================================================================
# CONEXIÓN A LA BASE DE DATOS
# ==============================================================================
# Tipo de gestor de base de datos
DB_CONNECTION=mysql
# Dirección IP del servidor de base de datos
DB_HOST=127.0.0.1
# Puerto de conexión MySQL
DB_PORT=3306
# Nombre de la base de datos del sistema
DB_DATABASE=gis
# Usuario administrador de MySQL
DB_USERNAME=root
# Contraseña del usuario MySQL (vacía en entorno local)
DB_PASSWORD=

# ==============================================================================
# CONTROLADORES DE SISTEMA (DRIVERS)
# ==============================================================================
# Driver para la transmisión de eventos en tiempo real (escribe en los logs por defecto)
BROADCAST_DRIVER=log
# Driver de caché de Laravel (usa la base de datos para almacenar datos temporales rápidos)
CACHE_DRIVER=file
# Disco de almacenamiento de archivos por defecto ('local' guarda en storage/app/)
FILESYSTEM_DISK=local
# Conexión de colas/trabajos en segundo plano ('sync' ejecuta todo al instante en el mismo request)
QUEUE_CONNECTION=sync
# Driver para las sesiones de usuario del navegador
SESSION_DRIVER=file
# Tiempo de vida de la sesión antes de expirar (en segundos o minutos según config de Laravel)
SESSION_LIFETIME=3000

# ==============================================================================
# SERVIDORES DE CACHÉ EN MEMORIA (OPCIONALES)
# ==============================================================================
# IP de conexión al servicio de caché Memcached
MEMCACHED_HOST=127.0.0.1
# IP de conexión al almacén en caché Redis
REDIS_HOST=127.0.0.1
# Contraseña de acceso a Redis
REDIS_PASSWORD=null
# Puerto de conexión a Redis
REDIS_PORT=6379

# ==============================================================================
# CONFIGURACIÓN DE ENVÍO DE CORREOS (SMTP)
# ==============================================================================
# Protocolo de envío de correo por defecto
MAIL_MAILER=smtp

# --- GMAIL ---
# Dirección del servidor SMTP de Gmail
MAIL_HOST=smtp.gmail.com
# Puerto SMTP seguro de Gmail
MAIL_PORT=587
# Cuenta de correo desde la cual saldrán las notificaciones
MAIL_USERNAME=grupoindustrialsaavedra@gmail.com
# Contraseña de aplicación de Gmail (generada en la cuenta de Google)
MAIL_PASSWORD="vuwm ltmp lhiv uplq"
# Tipo de cifrado de seguridad
MAIL_ENCRYPTION=tls

# Remitente que verán los usuarios en los correos recibidos
MAIL_FROM_ADDRESS="grupoindustrialsaavedra@gmail.com"
MAIL_FROM_NAME="Sistema GIS Saavedra"

