# ==============================================================================
# CONFIGURACIÓN GENERAL DE LA APLICACIÓN
# ==============================================================================
# Nombre de la aplicación (se muestra en correos y encabezados)
APP_NAME="Sistema GIS Saavedra"

# Entorno de ejecución:
# - 'local': Para desarrollo en tu computadora.
# - 'production': Para el servidor real en producción (cPanel/Neubox).
APP_ENV=local

# Clave de cifrado de la aplicación.
# En local se genera con: php artisan key:generate
APP_KEY=

# Mostrar detalles de errores:
# - 'true': En tu PC local para depurar.
# - 'false': OBLIGATORIO en producción para no exponer datos sensibles.
APP_DEBUG=true

# URL base de acceso:
# - En tu computadora: http://localhost
# - En el servidor: https://api.grupoindsaavedra.com
APP_URL=http://localhost

# ==============================================================================
# SEGURIDAD Y CONTROL DE ACCESO POR RED (IP WHITELIST)
# ==============================================================================
# IPs públicas autorizadas para operadores (Perfil 2) por planta.
# Acepta varias IPs separadas por coma, así como prefijos IPv6.
# Los usuarios Master (3) y Admin (1) tienen acceso libre global desde cualquier IP.
# - Planta Tecámac (ej. 189.191.191.86,2806:105e:1c:4008):
PLANTA_TECAMAC_ALLOWED_IPS=127.0.0.1
# - Planta La Raza (dejar vacío si aún no se tiene la IP):
PLANTA_LA_RAZA_ALLOWED_IPS=

# ==============================================================================
# CONFIGURACIÓN DE REGISTRO DE ERRORES (LOGS)
# ==============================================================================
# Canal por defecto (escribe en storage/logs/laravel.log)
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null

# Nivel de detalle: 'debug' en desarrollo, 'error' en el servidor de producción
LOG_LEVEL=debug

# ==============================================================================
# CONEXIÓN A LA BASE DE DATOS (MYSQL)
# ==============================================================================
DB_CONNECTION=mysql

# Host del servidor MySQL (casi siempre 127.0.0.1 tanto en local como en cPanel)
DB_HOST=127.0.0.1
DB_PORT=3306

# Nombre de la base de datos:
# - En local: gis
# - En cPanel: usuario_nombrebd (ej. grupoi67_gis)
DB_DATABASE=tu_base_de_datos

# Usuario de MySQL:
# - En local: root
# - En cPanel: usuario_nombreuser (ej. grupoi67_grupoi67)
DB_USERNAME=tu_usuario

# Contraseña de la base de datos (vacía en XAMPP local, contraseña segura en cPanel)
DB_PASSWORD="tu_contraseña"

# ==============================================================================
# CONTROLADORES DE SISTEMA (DRIVERS)
# ==============================================================================
BROADCAST_DRIVER=log
CACHE_DRIVER=database
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=3000

# En producción con HTTPS, descomentar para proteger sesiones:
# SESSION_DOMAIN=.grupoindsaavedra.com
# SESSION_SECURE_COOKIE=true

# ==============================================================================
# SERVIDORES DE CACHÉ EN MEMORIA (OPCIONALES)
# ==============================================================================
MEMCACHED_HOST=127.0.0.1
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ==============================================================================
# CONFIGURACIÓN DE ENVÍO DE CORREOS (GMAIL SMTP)
# ==============================================================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
# Correo de Gmail corporativo que enviará los correos
MAIL_USERNAME=tu_correo@gmail.com
# Contraseña de aplicación de 16 letras generada en Google Account (no tu contraseña normal)
MAIL_PASSWORD="tu_contraseña_de_aplicacion"
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="tu_correo@gmail.com"
MAIL_FROM_NAME="Sistema GIS Saavedra"

# ==============================================================================
# DESTINATARIOS DE CORREO POR DEPARTAMENTO
# ==============================================================================
# Coloca los correos reales de cada responsable de área:
EMAIL_SISTEMAS="sistemas@empresa.com"
EMAIL_ABRAHAM="abraham@empresa.com"
EMAIL_AUX_PRODUCCION="auxproduccion@empresa.com"
EMAIL_PRODUCCION="produccion@empresa.com"
EMAIL_AUX_ADM="auxadm@empresa.com"
EMAIL_REQUISICIONES="requisiciones@empresa.com"
EMAIL_ALMACEN_BASE="almacen@empresa.com"
EMAIL_INSPECCION="inspeccion@empresa.com"
EMAIL_INGENIERIA_STEELFS="ingenieria@empresa.com"
EMAIL_AUX_INGENIERIA_SS="auxingenieria@empresa.com"
EMAIL_PRODUCCION_SS_BASE="produccion_ss@empresa.com"
EMAIL_ASISTENTE_PROD_SS="asistente@empresa.com"
EMAIL_LABORATORIO_SS="laboratorio@empresa.com"
EMAIL_VENTAS_JACARANDAS_BASE="ventas@empresa.com"
EMAIL_ALEJANDRO="alejandro@empresa.com"
EMAIL_JUAN="juan@empresa.com"
EMAIL_BLANCA="blanca@empresa.com"
EMAIL_ANALILIA="analilia@empresa.com"
EMAIL_ACABADOS_MEX="acabados@empresa.com"

# ==============================================================================
# GRUPOS DE NOTIFICACIONES (COMPUESTOS / LISTAS)
# ==============================================================================
REPORT_RECIPIENTS="${EMAIL_SISTEMAS},${EMAIL_ABRAHAM},${EMAIL_AUX_PRODUCCION},${EMAIL_PRODUCCION},${EMAIL_AUX_ADM},${EMAIL_REQUISICIONES}"
ALMACEN_EMAIL="${EMAIL_ALMACEN_BASE},${EMAIL_INSPECCION},${EMAIL_REQUISICIONES},${EMAIL_AUX_PRODUCCION},${EMAIL_PRODUCCION}"
EMAIL_ALMACEN="${EMAIL_ALMACEN_BASE},${EMAIL_REQUISICIONES},${EMAIL_AUX_PRODUCCION},${EMAIL_PRODUCCION}"
EMAIL_CALIDAD="${EMAIL_INSPECCION},${EMAIL_REQUISICIONES},${EMAIL_AUX_PRODUCCION},${EMAIL_PRODUCCION}"
EMAIL_PROVEEDOR_MODELOS="${EMAIL_INGENIERIA_STEELFS},${EMAIL_AUX_INGENIERIA_SS},${EMAIL_REQUISICIONES},${EMAIL_AUX_PRODUCCION},${EMAIL_PRODUCCION}"
EMAIL_PRODUCCION_SS="${EMAIL_PRODUCCION_SS_BASE},${EMAIL_ASISTENTE_PROD_SS},${EMAIL_LABORATORIO_SS},${EMAIL_REQUISICIONES}"
EMAIL_PRODUCCION_JACARANDAS="${EMAIL_VENTAS_JACARANDAS_BASE},${EMAIL_REQUISICIONES}"
EMAIL_CC_GENERAL="${EMAIL_ALEJANDRO},${EMAIL_JUAN},${EMAIL_ABRAHAM},${EMAIL_INSPECCION},${EMAIL_REQUISICIONES},${EMAIL_AUX_ADM},${EMAIL_PRODUCCION},${EMAIL_AUX_PRODUCCION}"
EMAIL_COMPRAS="${EMAIL_ANALILIA}"
EMAIL_PTA="${EMAIL_ACABADOS_MEX},${EMAIL_ALEJANDRO}"

# ==============================================================================
# ALMACENAMIENTO EN LA NUBE (AWS S3) - OPCIONAL
# ==============================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ==============================================================================
# NOTIFICACIONES EN TIEMPO REAL (PUSHER) - OPCIONAL
# ==============================================================================
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# ==============================================================================
# VARIABLES COMPILADAS POR VITE (FRONTEND)
# ==============================================================================
VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
