# ==============================================================================
# CONFIGURACIÓN GENERAL DE LA APLICACIÓN
# ==============================================================================
APP_NAME="Sistema GIS Saavedra"
# CAMBIADO: 'production' optimiza Laravel para el servidor real
APP_ENV=production
APP_KEY=base64:/dm1Njdxyzw2GkirVkoTL1kbXqA0GzZ0umVukEdc6Do=
# CAMBIADO: CRÍTICO ponerlo en 'false'. Si falla algo, no mostrará tu código fuente a los usuarios.
APP_DEBUG=false
# CAMBIAR: Pon el dominio exacto que compraste en Neubox (asegúrate de usar https://)
APP_URL=https://tudominio.com

# ==============================================================================
# SEGURIDAD Y CONTROL DE ACCESO POR RED
# ==============================================================================
# IPs públicas autorizadas de la planta para operadores (separadas por comas).
# Ejemplo: 189.203.45.12,201.100.20.5 (los Master/Admin tienen acceso libre global).
PLANTA_ALLOWED_IPS=127.0.0.1

# ==============================================================================
# CONFIGURACIÓN DE LOGS (REGISTRO DE ERRORES)
# ==============================================================================
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
# CAMBIADO: 'error' para que en producción solo registre fallos reales, no advertencias tontas que llenen el disco.
LOG_LEVEL=error

# ==============================================================================
# CONEXIÓN A LA BASE DE DATOS
# ==============================================================================
DB_CONNECTION=mysql
# En cPanel/Neubox, el host casi siempre se queda en 127.0.0.1 o localhost
DB_HOST=127.0.0.1
DB_PORT=3306
# CAMBIAR: Nombre exacto de la base de datos que creaste en el cPanel (suele tener un prefijo, ej. user_saavedra)
DB_DATABASE=nombre_de_la_base_de_datos_en_cpanel
# CAMBIAR: Usuario de MySQL que creaste y asignaste a la base de datos
DB_USERNAME=usuario_de_la_base_de_datos_en_cpanel
# CAMBIAR: La contraseña que le pusiste a ese usuario
DB_PASSWORD="tu_contraseña_secreta"

# ==============================================================================
# CONTROLADORES DE SISTEMA (DRIVERS)
# ==============================================================================
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=3000

# ==============================================================================
# SERVIDORES DE CACHÉ EN MEMORIA (OPCIONALES)
# ==============================================================================
MEMCACHED_HOST=127.0.0.1
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ==============================================================================
# CONFIGURACIÓN DE ENVÍO DE CORREOS (SMTP)
# ==============================================================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=grupoindustrialsaavedra@gmail.com
MAIL_PASSWORD="vuwm ltmp lhiv uplq"
