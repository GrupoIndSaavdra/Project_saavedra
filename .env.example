# ==============================================================================
# CONFIGURACIÓN GENERAL DE LA APLICACIÓN
# ==============================================================================
APP_NAME="Sistema GIS Saavedra"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
ASSET_URL=null

# ==============================================================================
# CONTROL DE ACCESO POR RED (IP WHITELIST)
# ==============================================================================
# Permite conexiones locales de la planta, IPs de Telmex y loopback
# Ejemplo producción: 189.191.196.35,2806:105e:1c:2108,189.191.191.86,2806:105e:1c:4008
PLANTA_TECAMAC_ALLOWED_IPS=127.0.0.1,::1
PLANTA_LA_RAZA_ALLOWED_IPS=

# ==============================================================================
# CONFIGURACIÓN DE LOGS (REGISTRO DE ERRORES)
# ==============================================================================
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ==============================================================================
# CONEXIÓN A LA BASE DE DATOS (MYSQL)
# ==============================================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gis
DB_USERNAME=root
DB_PASSWORD=

# ==============================================================================
# CONTROLADORES DE SISTEMA (DRIVERS)
# ==============================================================================
BROADCAST_DRIVER=log
CACHE_DRIVER=database
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=3000
# SESSION_DOMAIN=.grupoindsaavedra.com
# SESSION_SECURE_COOKIE=true

# ==============================================================================
# SERVIDORES DE CACHÉ EN MEMORIA (OPCIONALES)
# ==============================================================================
MEMCACHED_HOST=127.0.0.1
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ==============================================================================
# CONFIGURACIÓN DE ENVÍO DE CORREOS (SMTP)
# ==============================================================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=correo_emisor@ejemplo.com
MAIL_PASSWORD="password_de_aplicacion"
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="correo_emisor@ejemplo.com"
MAIL_FROM_NAME="Sistema GIS Saavedra"

# ==============================================================================
# FLUJO DE TRABAJO DE FUNDICIÓN (CORREOS INDIVIDUALES)
# ==============================================================================
EMAIL_SISTEMAS="sistemas@ejemplo.com"
EMAIL_ABRAHAM="abraham@ejemplo.com"
EMAIL_AUX_PRODUCCION="auxproduccion@ejemplo.com"
EMAIL_PRODUCCION="produccion@ejemplo.com"
EMAIL_AUX_ADM="auxadm@ejemplo.com"
EMAIL_REQUISICIONES="requisiciones@ejemplo.com"
EMAIL_ALMACEN_BASE="almacen@ejemplo.com"
EMAIL_INSPECCION="inspeccion@ejemplo.com"
EMAIL_INGENIERIA_STEELFS="ingenieria@ejemplo.com"
EMAIL_AUX_INGENIERIA_SS="auxingenieria@ejemplo.com"
EMAIL_PRODUCCION_SS_BASE="produccion_ss@ejemplo.com"
EMAIL_ASISTENTE_PROD_SS="asistente@ejemplo.com"
EMAIL_LABORATORIO_SS="laboratorio@ejemplo.com"
EMAIL_VENTAS_JACARANDAS_BASE="ventas@ejemplo.com"
EMAIL_ALEJANDRO="alejandro@ejemplo.com"
EMAIL_JUAN="juan@ejemplo.com"
EMAIL_BLANCA="blanca@ejemplo.com"
EMAIL_ANALILIA="analilia@ejemplo.com"
EMAIL_ACABADOS_MEX="acabados@ejemplo.com"

# ==============================================================================
# REPORTES Y NOTIFICACIONES (NESTED / COMPUESTOS)
# ==============================================================================
REPORT_RECIPIENTS="${EMAIL_SISTEMAS},${EMAIL_ABRAHAM},${EMAIL_AUX_PRODUCCION},${EMAIL_PRODUCCION},${EMAIL_AUX_ADM},${EMAIL_REQUISICIONES}"
ALMACEN_EMAIL="${EMAIL_ALMACEN_BASE},${EMAIL_INSPECCION},${EMAIL_REQUISICIONES},${EMAIL_AUX_PRODUCCION},${EMAIL_PRODUCCION}"
EMAIL_ALMACEN="${EMAIL_ALMACEN_BASE},${EMAIL_REQUISICIONES},${EMAIL_AUX_PRODUCCION},${EMAIL_PRODUCCION}"
EMAIL_CALIDAD="${EMAIL_INSPECCION},${EMAIL_REQUISICIONES},${EMAIL_AUX_PRODUCCION},${EMAIL_PRODUCCION}"
EMAIL_PROVEEDOR_MODELOS="${EMAIL_INGENIERIA_STEELFS},${EMAIL_AUX_INGENIERIA_SS},${EMAIL_REQUISICIONES},${EMAIL_AUX_PRODUCCION},${EMAIL_PRODUCCION}"
EMAIL_PRODUCCION_SS="${EMAIL_PRODUCCION_SS_BASE},${EMAIL_ASISTENTE_PROD_SS},${EMAIL_LABORATORIO_SS},${EMAIL_REQUISICIONES}"
EMAIL_PRODUCCION_JACARANDAS="${EMAIL_VENTAS_JACARANDAS_BASE},${EMAIL_REQUISICIONES}"
EMAIL_CC_GENERAL="${EMAIL_ALEJANDRO},${EMAIL_JUAN},${EMAIL_ABRAHAM},${EMAIL_INSPECCION},${EMAIL_REQUISICIONES},${EMAIL_AUX_ADM},${EMAIL_PRODUCCION},${EMAIL_AUX_PRODUCCION}"
EMAIL_COMPRAS="${EMAIL_ANALILIA}"
EMAIL_PTA="${EMAIL_ACABADOS_MEX},${EMAIL_ALEJANDRO}"

# ==============================================================================
# AUTORIZACIÓN DE SINCRONIZACIÓN SEGURA (SAAVEDRA SYNC LOCAL <-> NUBE)
# ==============================================================================
# Token de producción (Planta Tecámac <-> cPanel con permisos completos de PUSH y PULL)
SYNC_API_TOKEN=coloca_aqui_el_token_secreto_compartido
# Token de desarrolladores (Devs en local: descarga manual PULL únicamente, PUSH bloqueado)
SYNC_DEV_TOKEN=coloca_aqui_el_token_desarrollador_para_devs
# Sincronización automática en segundo plano (true en servidor de producción, false en devs)
SYNC_AUTO_ENABLED=true
SYNC_CLOUD_URL=https://api.grupoindsaavedra.com
SYNC_BATCH_SIZE=250
SYNC_TIMEOUT=90
SYNC_PING_TIMEOUT=4
SYNC_FILES_ENABLED=true
SYNC_BACKUP_PATH="C:/Respaldos_Saavedra"
SYNC_BACKUP_RETENTION_DAYS=15

# ==============================================================================
# ALMACENAMIENTO EN LA NUBE (AWS S3) - SIN CONFIGURAR
# ==============================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ==============================================================================
# CONFIGURACIÓN DE PUSHER
# ==============================================================================
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# ==============================================================================
# VARIABLES FRONTEND (VITE)
# ==============================================================================
VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
