# ==============================================================================
# CONFIGURACIÓN GENERAL DE LA APLICACIÓN
# ==============================================================================
# Nombre de la aplicación que se mostrará en correos, encabezados y vistas
APP_NAME="Sistema GIS Saavedra"

# Entorno de ejecución:
# - 'production': Para el servidor real en cPanel / Neubox (optimiza Laravel).
# - 'local': Para desarrollo en tu computadora personal.
APP_ENV=production

# Clave de cifrado de 32 caracteres (AES-256).
# - En local o servidor nuevo, genérala ejecutando: php artisan key:generate
APP_KEY=

# Mostrar detalles de errores en pantalla:
# - 'false': OBLIGATORIO en producción (evita filtrar contraseñas o código si ocurre un error).
# - 'true': Solo en tu máquina local para depurar fallos mientras desarrollas.
APP_DEBUG=false

# URL base oficial del sistema:
# - En producción: https://api.grupoindsaavedra.com
# - En tu computadora: http://localhost
APP_URL=https://api.grupoindsaavedra.com

# URL para assets estáticos (CSS, JS, imágenes). Déjalo en 'null' a menos que uses un CDN externo.
ASSET_URL=null

# ==============================================================================
# CONTROL DE ACCESO POR RED (IP WHITELIST POR PLANTA)
# ==============================================================================
# Restringe el acceso al login de los Operadores (Perfil 2) en producción.
# Acepta una o varias IPs públicas y prefijos IPv6 separados por coma.
# (Los perfiles Master 3 y Admin 1 tienen acceso global desde cualquier lugar).

# IP pública e IPv6 de Planta Tecámac (ejemplo: 189.191.191.86,2806:105e:1c:4008):
PLANTA_TECAMAC_ALLOWED_IPS=

# IP pública de Planta La Raza (déjalo vacío si aún no se tiene asignada):
PLANTA_LA_RAZA_ALLOWED_IPS=

# ==============================================================================
# CONFIGURACIÓN DE LOGS (REGISTRO DE ERRORES)
# ==============================================================================
# Canal de logs por defecto (escribe en storage/logs/laravel.log)
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null

# Nivel mínimo de eventos a registrar:
# - 'error': En producción para solo registrar fallas reales y no saturar el disco.
# - 'debug': En desarrollo local para ver cada advertencia y consulta.
LOG_LEVEL=error

# ==============================================================================
# CONEXIÓN A LA BASE DE DATOS (MYSQL)
# ==============================================================================
DB_CONNECTION=mysql

# Host y puerto (en cPanel/Neubox y XAMPP casi siempre es 127.0.0.1 en puerto 3306)
DB_HOST=127.0.0.1
DB_PORT=3306

# Nombre exacto de la base de datos MySQL (en cPanel suele llevar prefijo de usuario, ej. usuario_gis)
DB_DATABASE=nombre_de_la_base_de_datos

# Usuario de MySQL con permisos sobre esa base de datos
DB_USERNAME=usuario_de_mysql

# Contraseña del usuario de MySQL
DB_PASSWORD="tu_contraseña_de_bd"

# ==============================================================================
# CONTROLADORES DE SISTEMA (DRIVERS)
# ==============================================================================
BROADCAST_DRIVER=log
CACHE_DRIVER=database
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=3000

# Dominio de sesión para cookies seguras en producción (permite compartir sesión entre subdominios):
# - En producción: .grupoindsaavedra.com
# - En local: déjalo vacío o comentado
SESSION_DOMAIN=.grupoindsaavedra.com

# Exigir HTTPS para la cookie de sesión:
# - 'true': OBLIGATORIO en producción con certificado SSL activo.
# - 'false': En tu máquina local si corres bajo http://
SESSION_SECURE_COOKIE=true

# ==============================================================================
# SERVIDORES DE CACHÉ EN MEMORIA (OPCIONALES)
# ==============================================================================
MEMCACHED_HOST=127.0.0.1
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ==============================================================================
# CONFIGURACIÓN DE ENVÍO DE CORREOS (GMAIL SMTP - PUERTO 465 SSL)
# ==============================================================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465

# Cuenta de Gmail corporativa que despachará los correos del sistema
MAIL_USERNAME=tu_correo@gmail.com

# Contraseña de aplicación de 16 letras generada en Google Account (no la clave normal de la cuenta)
# Generar en: https://myaccount.google.com/apppasswords
MAIL_PASSWORD="xxxx xxxx xxxx xxxx"

MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="tu_correo@gmail.com"
MAIL_FROM_NAME="Sistema GIS Saavedra"

# ==============================================================================
# DESTINATARIOS DE CORREO POR DEPARTAMENTO (INDIVIDUALES)
# ==============================================================================
# Correos de ejemplo de cada responsable de área (reemplazar por los correos reales en tu .env):
EMAIL_SISTEMAS="sistemas@ejemplo.com"
EMAIL_ABRAHAM="abraham@ejemplo.com"
EMAIL_AUX_PRODUCCION="auxproduccion@ejemplo.com"
EMAIL_PRODUCCION="produccion@ejemplo.com"
EMAIL_AUX_ADM="auxadm@ejemplo.com"
EMAIL_REQUISICIONES="requisiciones@ejemplo.com"
EMAIL_ALMACEN_BASE="almacen@ejemplo.com"
EMAIL_INSPECCION="inspeccion@ejemplo.com"
EMAIL_INGENIERIA_STEELFS="ingenieria@ejemplo.com"
EMAIL_AUX_INGENIERIA_SS="auxingenieria@ejemplo.com"
EMAIL_PRODUCCION_SS_BASE="produccion_ss@ejemplo.com"
EMAIL_ASISTENTE_PROD_SS="asistente@ejemplo.com"
EMAIL_LABORATORIO_SS="laboratorio@ejemplo.com"
EMAIL_VENTAS_JACARANDAS_BASE="ventas@ejemplo.com"
EMAIL_ALEJANDRO="alejandro@ejemplo.com"
EMAIL_JUAN="juan@ejemplo.com"
EMAIL_BLANCA="blanca@ejemplo.com"
EMAIL_ANALILIA="analilia@ejemplo.com"
EMAIL_ACABADOS_MEX="acabados@ejemplo.com"

# ==============================================================================
# GRUPOS DE NOTIFICACIONES (COMPUESTOS / LISTAS ANIDADAS)
# ==============================================================================
# Grupos de distribución automática que combinan los correos definidos arriba
REPORT_RECIPIENTS="${EMAIL_SISTEMAS},${EMAIL_ABRAHAM},${EMAIL_AUX_PRODUCCION},${EMAIL_PRODUCCION},${EMAIL_AUX_ADM},${EMAIL_REQUISICIONES}"
ALMACEN_EMAIL="${EMAIL_ALMACEN_BASE},${EMAIL_INSPECCION},${EMAIL_REQUISICIONES},${EMAIL_AUX_PRODUCCION},${EMAIL_PRODUCCION}"
EMAIL_ALMACEN="${EMAIL_ALMACEN_BASE},${EMAIL_REQUISICIONES},${EMAIL_AUX_PRODUCCION},${EMAIL_PRODUCCION}"
EMAIL_CALIDAD="${EMAIL_INSPECCION},${EMAIL_REQUISICIONES},${EMAIL_AUX_PRODUCCION},${EMAIL_PRODUCCION}"
EMAIL_PROVEEDOR_MODELOS="${EMAIL_INGENIERIA_STEELFS},${EMAIL_AUX_INGENIERIA_SS},${EMAIL_REQUISICIONES},${EMAIL_AUX_PRODUCCION},${EMAIL_PRODUCCION}"
EMAIL_PRODUCCION_SS="${EMAIL_PRODUCCION_SS_BASE},${EMAIL_ASISTENTE_PROD_SS},${EMAIL_LABORATORIO_SS},${EMAIL_REQUISICIONES}"
EMAIL_PRODUCCION_JACARANDAS="${EMAIL_VENTAS_JACARANDAS_BASE},${EMAIL_REQUISICIONES}"
EMAIL_CC_GENERAL="${EMAIL_ALEJANDRO},${EMAIL_JUAN},${EMAIL_ABRAHAM},${EMAIL_INSPECCION},${EMAIL_REQUISICIONES},${EMAIL_AUX_ADM},${EMAIL_PRODUCCION},${EMAIL_AUX_PRODUCCION}"
EMAIL_COMPRAS="${EMAIL_ANALILIA}"
EMAIL_PTA="${EMAIL_ACABADOS_MEX},${EMAIL_ALEJANDRO}"

# ==============================================================================
# ALMACENAMIENTO EN LA NUBE (AWS S3) - OPCIONAL
# ==============================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ==============================================================================
# NOTIFICACIONES EN TIEMPO REAL (PUSHER) - OPCIONAL
# ==============================================================================
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# ==============================================================================
# VARIABLES COMPILADAS POR VITE (FRONTEND)
# ==============================================================================
VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
